{
  "name": "bionic-redr",
  "displayName": "Bionic Redr",
  "version": "0.1.0",
  "description": "Attention optimization software for the information age. Reduces cognitive friction while reading the web.",
  "author": "Bionic Redr",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^11.3.19",
    "plasmo": "0.88.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/chrome": "0.0.270",
    "@types/node": "20.14.10",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "prettier": "3.3.3",
    "tailwindcss": "^3.4.6",
    "typescript": "5.4.5"
  },
  "overrides": {
    "sharp": "^0.34.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "manifest": {
    "name": "Bionic Redr — Attention optimizer",
    "host_permissions": [
      "<all_urls>"
    ],
    "permissions": [
      "storage",
      "activeTab",
      "scripting"
    ],
    "action": {
      "default_title": "Bionic Redr"
    },
    "commands": {
      "toggle-sidebar": {
        "suggested_key": {
          "default": "Ctrl+Shift+B",
          "mac": "Command+Shift+B"
        },
        "description": "Open Bionic Redr sidebar"
      }
    }
  }
}
